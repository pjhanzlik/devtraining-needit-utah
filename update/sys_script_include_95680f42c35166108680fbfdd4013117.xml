        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[class NeedItGlideAjax extends global.AbstractAjaxProcessor {
	/**
	 * Retreive a User email address using sysparm_user_id
	 * @returns {string} email on User table of sysparm_user_id record
	 */
	getEmail() {
		const USER = new GlideRecordSecure('sys_user');
		USER.get(this.getParameter('sysparm_user_id'));
		return USER.email;
	}
}]]></script>
