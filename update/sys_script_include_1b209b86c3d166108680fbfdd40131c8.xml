        <script><![CDATA[class NeedItUtils {
	/**
	 * Test if a date is before now
	 * @parameter {string} test_date - date that will be compared to now's GlideDateTime
	 * @return {boolean} - true if date string is before now
	 */ 
	beforeEndOfDay(test_date) {
		const TEST = new GlideDateTime(test_date);
		const END_OF_DAY = new GlideDateTime(gs.daysAgoEnd(0));
		return TEST.before(END_OF_DAY);
	}
}]]></script>
