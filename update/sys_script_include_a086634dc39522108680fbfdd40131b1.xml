        <api_name>x_58872_needit.validateEmailAddress</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Validate email address syntax using regular expressions.</description>
        <mobile_callable>false</mobile_callable>
        <name>validateEmailAddress</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function validateEmailAddress(string) {
	const EMAIL_REGEX = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;

	return EMAIL_REGEX.test(string);
}]]></script>
