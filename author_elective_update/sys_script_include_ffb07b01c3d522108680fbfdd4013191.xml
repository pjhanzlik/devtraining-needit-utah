        <api_name>x_58872_needit.NeedItAjax</api_name>
        <caller_access/>
        <client_callable>true</client_callable>
        <description>Return the email address of a specified user by sys_id.</description>
        <mobile_callable>false</mobile_callable>
        <name>NeedItAjax</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[
// Extend the global.AbstractAjaxProcessor class
class NeedItAjax extends global.AbstractAjaxProcessor {
  // Define the getEmail function.  
  // Create a GlideRecord for the User table.
  // Use the sysparm_userID passed from the client side to retrieve a record from the User table.
  // Return the email address for the requested record
  getEmail() {
    const userRecord = new GlideRecordSecure("sys_user");
    userRecord.get(this.getParameter('sysparm_user'));
    return userRecord.email;
  }
}]]></script>
